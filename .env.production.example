# Copy to .env.production on the server. Never commit that real file.
APP_DOMAIN=your-domain.example

# First startup creates this individual administrator account if the user table is empty.
# Use a unique email and a generated password of at least 16 characters.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=CASAI Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-16-plus-character-password
SESSION_TTL_HOURS=12
MAX_IMAGE_UPLOAD_BYTES=26214400
MAX_FLOOR_PLAN_UPLOAD_BYTES=104857600
MAX_NATIVE_UPLOAD_BYTES=2147483648

# DigitalOcean Managed PostgreSQL connection string. URL-encode special password characters.
DATABASE_URL=postgresql+psycopg://user:password@host:25060/database?sslmode=require

# DigitalOcean Spaces: use the bucket's region and endpoint, e.g. nyc3.
S3_BUCKET=your-private-space-name
S3_REGION=nyc3
S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
AWS_ACCESS_KEY_ID=your-spaces-access-key
AWS_SECRET_ACCESS_KEY=your-spaces-secret-key
