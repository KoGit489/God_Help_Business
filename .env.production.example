# Copy to .env.production on the server. Never commit that real file.
APP_DOMAIN=your-domain.example

# First startup creates this individual administrator account if the user table is empty.
# Use a unique email and a generated password of at least 16 characters.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=CASAI Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-16-plus-character-password
SESSION_TTL_HOURS=12
# memory:// is suitable only for one app process; use an authenticated Redis
# URI shared by all workers before scaling. Keep Redis credentials private.
RATE_LIMIT_STORAGE_URI=memory://
# Optional server-side error monitoring; leave blank to send nothing.
SENTRY_DSN=
# Password recovery uses SMTP STARTTLS. Leave SMTP_HOST blank to disable it.
# PUBLIC_APP_ORIGIN defaults to https://APP_DOMAIN when left blank.
PUBLIC_APP_ORIGIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Enable only after SMTP delivery has been tested. Legacy accounts are migrated
# as verified; accounts created afterward must confirm their email.
EMAIL_VERIFICATION_REQUIRED=false
# Public self-registration also requires EMAIL_VERIFICATION_REQUIRED=true.
ALLOW_ACCOUNT_REGISTRATION=false
# Generate and securely back up a Fernet key before enabling authenticator MFA.
# Leave blank until configured; never commit or rotate it without a migration.
MFA_ENCRYPTION_KEY=
MAX_IMAGE_UPLOAD_BYTES=26214400
MAX_FLOOR_PLAN_UPLOAD_BYTES=104857600
MAX_NATIVE_UPLOAD_BYTES=2147483648

# DigitalOcean Managed PostgreSQL connection string. URL-encode special password characters.
DATABASE_URL=postgresql+psycopg://user:password@host:25060/database?sslmode=require
# Enable only after deploying project RLS policies and a non-owner runtime role
# according to docs/data-protection-rollout.md. Strict mode disables startup migrations.
DATABASE_REQUIRE_RLS=false
# First-party daily aggregate analytics. Leave off until privacy notice and consent are approved.
ANALYTICS_ENABLED=false

# DigitalOcean Spaces: use the bucket's region and endpoint, e.g. nyc3.
S3_BUCKET=your-private-space-name
S3_REGION=nyc3
S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
AWS_ACCESS_KEY_ID=your-spaces-access-key
AWS_SECRET_ACCESS_KEY=your-spaces-secret-key
