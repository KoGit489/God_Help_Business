APP_ENV=development
APP_PERSISTENCE=memory
DATABASE_URL=postgresql+psycopg://appuser:apppass@localhost:5432/god_help_business

STORAGE_BACKEND=local
UPLOAD_DIR=uploaded_files

# Optional for S3 storage backend
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=

# Frontend share page base URL
PUBLIC_SHARE_BASE_URL=http://127.0.0.1:5500/frontend/share.html

# Seed demo project/pins at startup
SEED_DEMO_DATA=true
